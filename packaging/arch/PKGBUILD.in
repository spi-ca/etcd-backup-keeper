# Generated by scripts/archpackage-build.sh. No source downloads or compilation.
pkgname=etcd-backup-keeper
pkgver=@PKGVER@
pkgrel=@PKGREL@
pkgdesc='Local etcd snapshot backup and verification CLI'
arch=('x86_64')
url='https://github.com/spi-ca/etcd-backup-keeper'
license=('BSD-3-Clause')
depends=('systemd')
backup=('etc/etcd-backup-keeper/config.toml')
# Preserve the exact supplied static ELF. No generated debug package.
options=('!strip' '!debug' '!lto' '!purge' '!zipman')
source=()
sha256sums=()

package() {
    cp -a -- "$startdir/payload/." "$pkgdir/"
}
